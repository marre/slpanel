{
  "name": "slpanel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "mkdir -p dist/client && concurrently -k -n web,worker -c green,blue \"npm:dev:web\" \"npm:dev:worker\"",
    "dev:web": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "build": "npm run typecheck && vite build && npm run build:worker",
    "build:worker": "node node_modules/@typescript/native/bin/tsc -p tsconfig.worker.json",
    "preview": "vite preview",
    "typecheck": "npm run typecheck:app && npm run typecheck:worker",
    "typecheck:app": "vue-tsc --noEmit -p tsconfig.app.json",
    "typecheck:worker": "node node_modules/@typescript/native/bin/tsc -p tsconfig.worker.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply slpanel --local",
    "db:migrate:remote": "wrangler d1 migrations apply slpanel --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@nuxt/ui": "^4.11.3",
    "hono": "^4.13.8",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "@eslint/js": "^10.0.1",
    "@iconify-json/lucide": "^1.2.68",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^25.9.8",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^9.2.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.1.1",
    "wrangler": "^4.136.3"
  }
}
