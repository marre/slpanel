{
  "name": "slpanel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "mkdir -p dist/client && concurrently -k -n web,worker,wasm -c green,blue,magenta \"npm:dev:web\" \"npm:dev:worker\" \"npm:dev:wasm\"",
    "dev:web": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "dev:wasm": "node scripts/watch-wasm.mjs",
    "build": "npm run typecheck && vite build && npm run build:worker",
    "build:worker": "node node_modules/@typescript/native/bin/tsc -p tsconfig.worker.json",
    "preview": "vite preview",
    "typecheck": "npm run typecheck:app && npm run typecheck:worker",
    "typecheck:app": "node node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.app.json",
    "typecheck:worker": "node node_modules/@typescript/native/bin/tsc -p tsconfig.worker.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply slpanel --local",
    "db:migrate:remote": "wrangler d1 migrations apply slpanel --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "react-select": "^5.10.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.4",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.3"
  }
}
